#!/usr/bin/env python3
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, GLib, Gdk
import subprocess
import threading

class BrightnessApp:
    def __init__(self):
        # Detecta monitores DDC/CI
        result = subprocess.run(['ddcutil', 'detect', '--terse'], 
                                capture_output=True, text=True)
        self.displays = []
        for line in result.stdout.split('\n'):
            if line.startswith('Display'):
                parts = line.split()
                if len(parts) >= 2:
                    self.displays.append(int(parts[1]))
        
        # Detecta outputs XRandR para software dimming
        self.xrandr_outputs = []
        try:
            out = subprocess.run(['xrandr', '--query'], capture_output=True, text=True).stdout
            for line in out.split('\n'):
                if ' connected' in line:
                    self.xrandr_outputs.append(line.split()[0])
        except:
            pass
        
        self.hw_brightness = 50      # 0-100 (DDC/CI)
        self.sw_brightness = 1.0     # 0.0-1.0 (xrandr)
        self.target_hw = 50
        self.target_sw = 1.0
        self.original_hw = 50
        self.original_sw = 1.0
        self._applying = False
        self._pending_hw = None
        self._pending_sw = None
        
        threading.Thread(target=self._fetch_current, daemon=True).start()
        
        self.window = Gtk.Window(title="Controle de Brilho")
        self.window.set_default_size(460, 200)
        self.window.set_position(Gtk.WindowPosition.CENTER)
        self.window.connect("destroy", Gtk.main_quit)
        
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_margin_top(15); box.set_margin_bottom(15)
        box.set_margin_start(20); box.set_margin_end(20)
        self.window.add(box)
        
        # --- Hardware Brightness ---
        hw_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        hw_label = Gtk.Label(label="🖥️  Brilho do Monitor (Hardware DDC/CI):")
        hw_label.set_halign(Gtk.Align.START)
        hw_box.pack_start(hw_label, False, False, 0)
        
        self.hw_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.hw_scale.set_value(self.hw_brightness)
        self.hw_scale.set_digits(0)
        self.hw_scale.set_value_pos(Gtk.PositionType.RIGHT)
        self.hw_scale.set_hexpand(True)
        self.hw_scale.set_draw_value(True)
        self.hw_scale.connect("value-changed", self.on_hw_changed)
        self.hw_scale.connect("button-release-event", self.on_hw_release)
        hw_box.pack_start(self.hw_scale, False, False, 0)
        box.pack_start(hw_box, False, False, 0)
        
        # --- Software Brightness ---
        sw_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        sw_label = Gtk.Label(label="🌑  Escurecimento Extra (Software - vai além do 0):")
        sw_label.set_halign(Gtk.Align.START)
        sw_box.pack_start(sw_label, False, False, 0)
        
        self.sw_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0.1, 1.0, 0.01)
        self.sw_scale.set_value(self.sw_brightness)
        self.sw_scale.set_digits(2)
        self.sw_scale.set_value_pos(Gtk.PositionType.RIGHT)
        self.sw_scale.set_hexpand(True)
        self.sw_scale.set_draw_value(True)
        self.sw_scale.connect("value-changed", self.on_sw_changed)
        self.sw_scale.connect("button-release-event", self.on_sw_release)
        sw_box.pack_start(self.sw_scale, False, False, 0)
        
        # Valor percentual label
        self.sw_pct_label = Gtk.Label(label="100%")
        self.sw_pct_label.set_halign(Gtk.Align.END)
        sw_box.pack_start(self.sw_pct_label, False, False, 0)
        box.pack_start(sw_box, False, False, 0)
        
        # Status
        self.status = Gtk.Label(label="")
        self.status.set_halign(Gtk.Align.START)
        box.pack_start(self.status, False, False, 0)
        
        # Botões
        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        btn_box.set_halign(Gtk.Align.END)
        
        btn_reset = Gtk.Button(label="Resetar (100% / 50%)")
        btn_reset.connect("clicked", self.on_reset)
        btn_box.pack_start(btn_reset, False, False, 0)
        
        btn_ok = Gtk.Button(label="OK")
        btn_ok.connect("clicked", self.on_ok)
        btn_box.pack_start(btn_ok, False, False, 0)
        
        btn_cancel = Gtk.Button(label="Cancelar")
        btn_cancel.connect("clicked", self.on_cancel)
        btn_box.pack_start(btn_cancel, False, False, 0)
        
        box.pack_start(btn_box, False, False, 0)
        self.window.show_all()
    
    def _fetch_current(self):
        # Hardware
        hw_val = 50
        try:
            if self.displays:
                result = subprocess.run(
                    ['ddcutil', 'getvcp', '10', '--display', str(self.displays[0])],
                    capture_output=True, text=True, timeout=3)
                import re
                match = re.search(r'current value\s*=\s*(\d+)', result.stdout)
                if match:
                    hw_val = int(match.group(1))
        except:
            pass
        
        # Software (xrandr)
        sw_val = 1.0
        try:
            if self.xrandr_outputs:
                result = subprocess.run(
                    ['xrandr', '--verbose'], capture_output=True, text=True, timeout=2)
                import re
                for line in result.stdout.split('\n'):
                    if 'Brightness:' in line:
                        match = re.search(r'Brightness:\s*([\d.]+)', line)
                        if match:
                            sw_val = float(match.group(1))
                            break
        except:
            pass
        
        GLib.idle_add(self._init_scales, hw_val, sw_val)
    
    def _init_scales(self, hw, sw):
        self.hw_brightness = self.target_hw = self.original_hw = hw
        self.sw_brightness = self.target_sw = self.original_sw = sw
        self.hw_scale.set_value(hw)
        self.sw_scale.set_value(sw)
        self._update_sw_label(sw)
        return False
    
    def _update_sw_label(self, val):
        self.sw_pct_label.set_text(f"{int(val * 100)}%")
    
    # --- Hardware apply loop ---
    def _apply_hw_loop(self):
        while True:
            self._applying = True
            target = self.target_hw
            GLib.idle_add(self.status.set_text, f"Aplicando hardware: {target}%...")
            
            for d in self.displays:
                subprocess.run(
                    ['ddcutil', 'setvcp', '10', str(target), '--display', str(d)],
                    capture_output=True, timeout=5)
            
            self.hw_brightness = target
            GLib.idle_add(self._done_hw)
            
            if self._pending_hw is not None and self._pending_hw != self.target_hw:
                self.target_hw = self._pending_hw
                self._pending_hw = None
                continue
            break
        
        self._applying = False
        GLib.idle_add(self.status.set_text, "")
    
    def _done_hw(self):
        return False
    
    def set_hw_async(self, value):
        self.target_hw = value
        if not self._applying:
            threading.Thread(target=self._apply_hw_loop, daemon=True).start()
        else:
            self._pending_hw = value
    
    # --- Software apply (instantâneo) ---
    def set_sw_async(self, value):
        self.target_sw = value
        self.sw_brightness = value
        GLib.idle_add(self._update_sw_label, value)
        
        def worker():
            for out in self.xrandr_outputs:
                subprocess.run(
                    ['xrandr', '--output', out, '--brightness', str(value)],
                    capture_output=True, timeout=2)
        threading.Thread(target=worker, daemon=True).start()
    
    # --- Callbacks ---
    def on_hw_changed(self, scale):
        self.set_hw_async(int(scale.get_value()))
        return False
    
    def on_hw_release(self, scale, event):
        self.set_hw_async(int(scale.get_value()))
        return False
    
    def on_sw_changed(self, scale):
        self.set_sw_async(scale.get_value())
        return False
    
    def on_sw_release(self, scale, event):
        self.set_sw_async(scale.get_value())
        return False
    
    def on_reset(self, widget):
        self.set_hw_async(50)
        self.hw_scale.set_value(50)
        self.set_sw_async(1.0)
        self.sw_scale.set_value(1.0)
        return False
    
    def on_ok(self, widget):
        Gtk.main_quit()
    
    def on_cancel(self, widget):
        self.set_hw_async(self.original_hw)
        self.set_sw_async(self.original_sw)
        Gtk.main_quit()
    
    def run(self):
        Gtk.main()

if __name__ == '__main__':
    app = BrightnessApp()
    app.run()
